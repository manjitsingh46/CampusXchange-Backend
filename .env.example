# Runtime
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Neon PostgreSQL pooled endpoint
DB_URL=jdbc:postgresql://your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace_me
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=300000
DB_MAX_LIFETIME_MS=900000
JPA_DDL_AUTO=update

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Google OAuth - optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HTTP and application behavior
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SEED_DEMO_DATA=false

# Leave blank in production to log only to stdout
LOG_FILE=
